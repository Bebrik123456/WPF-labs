<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="WPF_labs.MainEmpty"
        Title="WPF_labs">
    <Grid>
        <StackPanel Spacing="1" HorizontalAlignment="Left" VerticalAlignment="Top" >
        <Image Source="Images/userHole.png" Height="200" Width="200" Cursor="Hand" Tapped="InputElement_OnTapped" Opacity="1" />
        <Border Name="Border1" Background="Gray" Width="200" Height="100">
          <StackPanel>
              <TextBlock Text="Выход" Cursor="Hand" Tapped="TextBlock1Element_OnTapped"/>
              <TextBlock Text="Изменить фото профиля" Cursor="Hand" />
          </StackPanel>
            
        </Border>
        </StackPanel>
    <Grid>
   
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            
          
            
            <StackPanel  Grid.Row="0" >
                <Label HorizontalAlignment="Center"
                      Margin=" 0 80 0 0"
                       Content="Добро пожаловать!"
                       FontSize="24"/>
               <Label HorizontalAlignment="Center"
                       Margin="0 40 0 0" Content="Создайте свою первую задачу!"
                       FontSize="23"/>
            </StackPanel>
            
                <StackPanel Grid.Row="2">
                    <Button Content="Создать первую задачу"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            HorizontalContentAlignment="Center"
                            Background="#f96060"
                            Foreground="White"
                            Click="SozdanieZadachi"/>
                </StackPanel>
        </Grid>
            </Grid>
        </Window>