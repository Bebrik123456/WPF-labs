<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="500" Height="60"
             Padding="10"
             Background="Bisque"
             x:Class="WPF_labs.Components.TaskBlock">
    <StackPanel x:Name="TaskPanel">
        <TextBlock x:Name="Title" FontSize="18">Title</TextBlock>
        <TextBlock x:Name="Subtitle">Subtitle</TextBlock>
    </StackPanel>
</UserControl>
